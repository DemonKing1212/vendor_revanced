app_domain(revanced_app)
binder_use(revanced_app)

allow revanced_app {
  activity_service
  activity_task_service
  app_api_service
  device_state_service
  hint_service
  media_session_service
  mediaextractor_service
  mediametrics_service
  mediaserver_service  
  permission_checker_service
}:service_manager find;

allow revanced_app system_app_data_file:dir create_dir_perms;
allow revanced_app system_app_data_file:{ file lnk_file } create_file_perms;

allow revanced_app system_server:binder { call transfer };

get_prop(revanced_app, revanced_prop)
set_prop(revanced_app, revanced_prop)